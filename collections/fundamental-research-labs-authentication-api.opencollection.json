{
  "opencollection": "1.0.0",
  "info": {
    "name": "Shortcut Authentication API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Verify API Key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/spreadsheets/verify",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Verifies that your API key is valid and returns information about the authenticated user"
        }
      ]
    }
  ],
  "bundled": true
}